# ── Paperclip-Deployment .env ────────────────────────────────────────────
# Copy to .env and fill in your values

# ── Database ─────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=your_postgres_password
DATABASE_URL=postgresql://postgres:your_password@x0k4w8404wckwwcswg808gco:5432/projects
BOT_COORDINATION_DB_PASS=your_postgres_password

# ── Paperclip SaaS ────────────────────────────────────────────────────────
PAPERCLIP_API_KEY=pcp_your_key_here
PAPERCLIP_API_URL=https://paperclip.rachkovan.com
PAPERCLIP_AGENT_ID=your_agent_id
PAPERCLIP_COMPANY_ID=209e81cd-41f2-4a0f-b420-951645b5cf64

# ── Hermes / OpenClaw ────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-your_key
DISCORD_BOT_TOKEN=your_discord_bot_token
HERMES_MODEL=minimax/minimax-m2.7
HERMES_INFERENCE_PROVIDER=openrouter

# ── Mem0 ─────────────────────────────────────────────────────────────────
MEM0_URL=http://mem0:5000
MEM0_API_KEY=mem0-self-hosted

# ── Temporal ─────────────────────────────────────────────────────────────
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default

# ── JWT ──────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production

# ── Sandbox ──────────────────────────────────────────────────────────────
TZ=Asia/Singapore
WORKSPACE=/workspace