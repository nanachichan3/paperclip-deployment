# Environment variables for paperclip-deployment

# Paperclip
PAPERCLIP_API_KEY=pcp_your_key_here
PAPERCLIP_COMPANY_ID=your_company_id
PAPERCLIP_API_URL=https://paperclip.rachkovan.com

# Hermes / OpenClaw
OPENROUTER_API_KEY=sk-or-your_key
DISCORD_BOT_TOKEN=your_discord_bot_token
HERMES_MODEL=minimax/minimax-m2.7
HERMES_INFERENCE_PROVIDER=openrouter

# Mem0
MEM0_URL=http://mem0:5000
MEM0_API_KEY=mem0-self-hosted

# Temporal
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default

# Database
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_MCP_DATABASE_URL=postgres://postgres:your_password@x0k4w8404wckwwcswg808gco:5432/postgres
PROJECTS_MCP_DATABASE_URL=postgres://postgres:your_password@x0k4w8404wckwwcswg808gco:5432/projects
DATABASE_URL=postgresql://postgres:your_password@x0k4w8404wckwwcswg808gco:5432/paperclip

# Sandbox
WORKSPACE=/home/gem/workspace
TZ=Asia/Singapore

# Coding CLIs
ANTHROPIC_API_KEY=sk-ant-your_key
OPENAI_API_KEY=sk-your_key
GOOGLE_API_KEY=your_google_key
GITHUB_TOKEN=ghp_your_token

# JWT
JWT_SECRET=change-me-in-production